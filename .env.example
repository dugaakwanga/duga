# =========================================================================
# DUGA PLATFORM — environment template
# Copy to `.env` (portal) / `apps/portal/.env` and fill in real values.
# =========================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://duga:duga@localhost:5432/duga?schema=public"

# ---------------------------------------------------------------------------
# Auth (JWT)
# ---------------------------------------------------------------------------
# Secret used to sign school-side auth tokens. Generate: `openssl rand -hex 32`
JWT_SECRET="change-me-super-secret"
# Secret used to sign Super Admin tokens (must differ from JWT_SECRET)
JWT_SECRET_SUPERADMIN="change-me-super-admin-secret"
# Token lifetimes (seconds)
JWT_EXPIRES_IN="8h"
JWT_EXPIRES_IN_SUPERADMIN="2h"

# ---------------------------------------------------------------------------
# Site / domains
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_PORTAL_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="De Ultimate Glory Academy"
NEXT_PUBLIC_SCHOOL_NAME="De Ultimate Glory Academy"
NEXT_PUBLIC_SCHOOL_SHORT_NAME="DUGA"
NEXT_PUBLIC_SCHOOL_PHONE="+234 803 000 0000"
NEXT_PUBLIC_SCHOOL_EMAIL="info@deultimateglory.com"
NEXT_PUBLIC_SCHOOL_ADDRESS="De Ultimate Glory Academy, Akwanga, Nasarawa State, Nigeria"
NEXT_PUBLIC_SCHOOL_LAT="8.9123"
NEXT_PUBLIC_SCHOOL_LNG="8.4066"

# ---------------------------------------------------------------------------
# Paystack (Nigerian payments) — use test keys in development
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxx"
PAYSTACK_CALLBACK_URL="http://localhost:3001/portal/payments/callback"

# ---------------------------------------------------------------------------
# SMS gateway (Termii / Twilio style). Leave blank to fall back to email + in-app.
# ---------------------------------------------------------------------------
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID="DUGA"

# ---------------------------------------------------------------------------
# Email (Resend / SMTP). Leave blank to log emails in dev.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=""
RESEND_API_KEY=""
MAIL_FROM="no-reply@deultimateglory.com"

# ---------------------------------------------------------------------------
# Live classes (Jitsi)
# ---------------------------------------------------------------------------
JITSI_HOST="meet.jit.si"
# Optional authenticated Jitsi deployment:
JITSI_APP_ID=""
JITSI_APP_SECRET=""

# ---------------------------------------------------------------------------
# Storage (Supabase Storage — public bucket "duga-assets")
# Project URL + anon key from Supabase Dashboard → Settings → API.
# Service role key is used server-side for uploads; NEVER expose it client-side.
# ---------------------------------------------------------------------------
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-public-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-secret>"

# ---------------------------------------------------------------------------
# School GPS (used for staff geofenced attendance)
# ---------------------------------------------------------------------------
SCHOOL_GPS_LAT="8.9123"
SCHOOL_GPS_LNG="8.4066"
# Allowed radius in meters for staff clock-in/out
ATTENDANCE_RADIUS_METERS="150"

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
NODE_ENV="development"
AUDIT_LOG_RETENTION_DAYS="730"
